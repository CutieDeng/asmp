;; ============================================================
;; 06-abi.d - ABI 声明示例
;; ============================================================
;;
;; 演示: 函数 ABI 属性声明
;;
;; 运行:
;;   racket cli/as.rkt example/06-abi.d                    # 需要 --default-abi
;;   racket cli/as.rkt --default-abi aapcs64 example/06-abi.d

;; ------------------------------------------------------------
;; 显式 ABI 声明
;; ------------------------------------------------------------
(: function explicit_abi (abi aapcs64))
(: label entry)
  (add x0 x0 x1 lsl 0)
  (ret)
(: end-function)

;; ------------------------------------------------------------
;; 叶函数 - 不调用其他函数，可优化
;; ------------------------------------------------------------
(: function leaf_func (abi leaf))
(: label entry)
  ;; 叶函数不需要保存 LR
  (madd x0 x0 x1 xzr)     ; x0 = x0 * x1
  (ret)
(: end-function)

;; ------------------------------------------------------------
;; 裸函数 - 完全手动控制
;; ------------------------------------------------------------
(: function naked_func (abi naked))
(: label entry)
  ;; 无自动序言/尾声，需要手动管理栈
  (stp x29 x30 (sp -16 !))
  (mov x29 sp)
  ;; ... 函数体 ...
  (ldp x29 x30 (sp))
  (add sp sp 16)
  (ret)
(: end-function)

;; ------------------------------------------------------------
;; 使用默认 ABI (由 --default-abi 指定)
;; ------------------------------------------------------------
(: function use_default)
(: label entry)
  (mov x0 42)
  (ret)
(: end-function)

;; ------------------------------------------------------------
;; 多属性
;; ------------------------------------------------------------
(: function multi_attr (abi aapcs64) (inline) (noinline))
(: label entry)
  (mov x0 0)
  (ret)
(: end-function)
